{
  "name": "paperland",
  "version": "2.1.3",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run packages/backend/src/index.ts & bun run --filter '@paperland/frontend' dev",
    "build": "bun run --filter '*' build",
    "build:frontend": "bash scripts/build-frontend.sh",
    "test": "bun run --filter '@paperland/backend' test"
  }
}
